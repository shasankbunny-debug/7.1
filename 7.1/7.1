class GoodMorningThread extends Thread {
    @Override
    public void run() {
        while (!isInterrupted()) { // Better practice than while(true)
            System.out.println("Good Morning");
            try {
                Thread.sleep(1000); // Standardized to Thread.sleep()
            } catch (InterruptedException e) {
                System.out.println("Good Morning thread interrupted.");
                break;
            }
        }
    }
}

class HelloThread extends Thread {
    @Override
    public void run() {
        while (!isInterrupted()) {
            System.out.println("Hello");
            try {
                Thread.sleep(2000);
            } catch (InterruptedException e) {
                System.out.println("Hello thread interrupted.");
                break;
            }
        }
    }
}

class WelcomeThread extends Thread {
    @Override
    public void run() {
        while (!isInterrupted()) {
            System.out.println("Welcome");
            try {
                Thread.sleep(3000);
            } catch (InterruptedException e) {
                System.out.println("Welcome thread interrupted.");
                break;
            }
        }
    }
}

public class ThreadDemo {
    public static void main(String[] args) {
        GoodMorningThread thread1 = new GoodMorningThread();
        HelloThread thread2 = new HelloThread();
        WelcomeThread thread3 = new WelcomeThread();

        // Threads start executing concurrently
        thread1.start();
        thread2.start();
        thread3.start();
    }
}
